{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Always send API routes to the Worker, even if an asset ever shadows them.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      // Unique per Cloudflare account. Change this if another Worker uses 1001.
      "namespace_id": "874201",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "vars": {
    "CONTACT_TO_EMAIL": "jlenteria98@gmail.com",
    "CONTACT_FROM_EMAIL": "Portfolio Contact <onboarding@resend.dev>"
  }
  // Once a custom domain is active, add it here (it must be a zone on this account):
  // "routes": [{ "pattern": "example.com", "custom_domain": true }]
}
