# Copy to .dev.vars for local development (`npm run dev`).
# For production, set each value with
# `npx wrangler pages secret put <NAME> --project-name jlenteria`, then redeploy.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where contact form messages are delivered (comma-separate for several)
CONTACT_TO_EMAIL=jlenteria98@gmail.com

# Sender address. Without a verified domain, use onboarding@resend.dev —
# Resend then only delivers to your own Resend account email, so sign up to
# Resend with the same address as CONTACT_TO_EMAIL.
# Once you own and verify a domain in Resend, switch to e.g. contact@yourdomain.com
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
